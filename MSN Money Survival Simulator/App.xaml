<Application
    x:Class="MSN_Money_Survival_Simulator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MSN_Money_Survival_Simulator">

    <Application.Resources>
        <!-- Windows 8.1 "Metro" palette, tuned for a finance clicker. -->
        <SolidColorBrush x:Key="InkBrush" Color="#0B1015"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151E26"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1E2A34"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00BCD4"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#00838F"/>
        <SolidColorBrush x:Key="WarmBrush" Color="#FFB300"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FF5252"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA0AE"/>
        <SolidColorBrush x:Key="BrightBrush" Color="#F2F7FA"/>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="SemiLight"/>
            <Setter Property="Foreground" Value="{StaticResource BrightBrush}"/>
            <Setter Property="CharacterSpacing" Value="60"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="CharacterSpacing" Value="100"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiLight"/>
            <Setter Property="Foreground" Value="{StaticResource BrightBrush}"/>
        </Style>

        <Style x:Key="BodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <!-- Click target: no default chrome, but keeps slick pointer feedback. -->
        <Style x:Key="CleanButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
