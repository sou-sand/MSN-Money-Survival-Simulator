<Page
    x:Class="MSN_Money_Survival_Simulator.AchievementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MSN_Money_Survival_Simulator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#111B23" BorderBrush="#22303B" BorderThickness="0,0,0,1" Padding="28,18,28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TROPHY CASE" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Milestones unlock automatically as you dismantle the money machine."
                               Style="{StaticResource BodyStyle}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="UNLOCKED" Style="{StaticResource LabelStyle}" TextAlignment="Right"/>
                    <TextBlock x:Name="UnlockCount" Text="0 / 0" FontSize="30" Foreground="{StaticResource AccentBrush}" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <GridView x:Name="AchievementGrid" Grid.Row="1" ItemsSource="{Binding Achievements}"
                  SelectionMode="None" IsItemClickEnabled="False" Padding="24,18,24,30">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Border Width="280" Height="150" Background="{Binding TileBrush}" Padding="16"
                            BorderBrush="#31414C" BorderThickness="1" Opacity="{Binding TileOpacity}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="40"
                                       Foreground="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiLight"
                                           Foreground="{StaticResource BrightBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{Binding StatusBrush}" CharacterSpacing="140" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapGrid Orientation="Horizontal" ItemWidth="296" ItemHeight="166" MaximumRowsOrColumns="4"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition/>
                </TransitionCollection>
            </GridView.ItemContainerTransitions>
        </GridView>

        <MediaElement x:Name="Sfx" Visibility="Collapsed"/>
    </Grid>
</Page>
