<UserControl
    x:Class="MSN_Money_Survival_Simulator.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Background="{StaticResource InkBrush}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,12,14,28">
            <TextBlock Text="SETTINGS" Style="{StaticResource TitleStyle}"/>
            <TextBlock Text="Tune the experience, reboot the timeline, or wipe the slate clean."
                       Style="{StaticResource BodyStyle}" Margin="0,4,0,14"/>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="#FF2B3A45"
                    BorderThickness="1" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="FEEDBACK" Style="{StaticResource LabelStyle}" Margin="0,0,0,8"/>
                    <CheckBox Content="Sound effects" IsChecked="{Binding SoundEnabled, Mode=TwoWay}"
                              Foreground="{StaticResource BrightBrush}" FontSize="15" MinHeight="44"/>
                    <CheckBox Content="Reduce motion" IsChecked="{Binding ReducedMotion, Mode=TwoWay}"
                              Foreground="{StaticResource BrightBrush}" FontSize="15" MinHeight="44"/>
                    <TextBlock Text="Reduced motion disables floating numbers and confetti."
                               Style="{StaticResource BodyStyle}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="#FF2B3A45"
                    BorderThickness="1" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="TIMELINE REBOOT" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Rewrite the timeline after 5 targets" FontSize="17"
                               FontWeight="Light" Foreground="{StaticResource BrightBrush}"
                               Margin="0,6,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="Start over with a permanent x1.3 damage multiplier for every reboot. Upgrades and cash reset; trophies and lifetime stats stay."
                               Style="{StaticResource BodyStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="MULTIPLIER " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding MultiplierText}" FontSize="16" Foreground="{StaticResource WarmBrush}"/>
                        <TextBlock Text="   TARGETS DOWN " Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding KillsText}" FontSize="16" Foreground="{StaticResource BrightBrush}"/>
                    </StackPanel>
                    <Button x:Name="AscendButton" Content="REBOOT TIMELINE" Click="Ascend_Click"
                            IsEnabled="{Binding CanAscend}" MinHeight="48" Margin="0,12,0,0"
                            Background="{StaticResource WarmBrush}" Foreground="#101820"
                            BorderThickness="0" FontSize="14"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="#FF2B3A45"
                    BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="DANGER ZONE" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="Erase every trace of the campaign" FontSize="17"
                               FontWeight="Light" Foreground="{StaticResource BrightBrush}"
                               Margin="0,6,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="Resets cash, upgrades, targets, trophies and reboots."
                               Style="{StaticResource BodyStyle}"/>
                    <Button Content="RESET EVERYTHING" Click="Reset_Click" MinHeight="48" Margin="0,12,0,0"
                            Background="#FF4A2328" Foreground="#FFFFD9D9" BorderThickness="0" FontSize="14"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
