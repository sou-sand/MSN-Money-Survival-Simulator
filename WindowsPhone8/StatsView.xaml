<UserControl
    x:Class="MSN_Money_Survival_Simulator.StatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#FF111B23" BorderBrush="#FF22303B" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="MARKET TELEMETRY" Style="{StaticResource TitleStyle}"/>
                <TextBlock Text="Live readout of your campaign against the money machine."
                           Style="{StaticResource BodyStyle}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="#FF2B3A45" BorderThickness="1"
                    Padding="10" Margin="0,0,4,4">
                <StackPanel>
                    <TextBlock Text="LIFETIME CASH" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TotalEarnedText}" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#FF2B3A45"
                    BorderThickness="1" Padding="10" Margin="4,0,0,4">
                <StackPanel>
                    <TextBlock Text="TOTAL CLICKS" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding TotalClicksText}" FontSize="22" Foreground="{StaticResource BrightBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#FF2B3A45"
                    BorderThickness="1" Padding="10" Margin="0,4,4,0">
                <StackPanel>
                    <TextBlock Text="UPGRADES OWNED" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding UpgradeCountText}" FontSize="22" Foreground="{StaticResource WarmBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="#FF2B3A45" BorderThickness="1" Padding="10" Margin="4,4,0,0">
                <StackPanel>
                    <TextBlock Text="ERA REBOOTS" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding Ascensions}" FontSize="22" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="12,6,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="CASH FLOW" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text=" / last 60 samples" Style="{StaticResource LabelStyle}" Margin="4,0,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#FF2B3A45"
                    BorderThickness="1">
                <Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
