<UserControl
    x:Class="MSN_Money_Survival_Simulator.ArenaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="ArenaView_Loaded">

    <Grid Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Boss status -->
        <Border Background="#FF111B23" BorderBrush="#FF22303B" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="CURRENT TARGET" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding BossName}" FontSize="20" Foreground="{StaticResource BrightBrush}"/>
                <TextBlock Text="{Binding BossHpText}" FontSize="13" Foreground="{StaticResource DangerBrush}" Margin="0,2,0,6"/>
                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding BossHpPercent}"
                             Foreground="{StaticResource DangerBrush}" Background="#FF28343D"/>
            </StackPanel>
        </Border>

        <!-- Arena -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF151E26" Padding="14,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DAMAGE / CLICK" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding ClickText}" FontSize="24" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="PER SECOND" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding DpsText}" FontSize="24" Foreground="{StaticResource WarmBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="COMBO" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding ComboText}" FontSize="17" Foreground="{StaticResource WarmBrush}"/>
                        <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ComboPercent}"
                                     Foreground="{StaticResource WarmBrush}" Background="#FF28343D" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="300" Height="300">
                <Ellipse x:Name="PulseEllipse" Width="290" Height="290"
                         Fill="{StaticResource AccentBrush}" Opacity="0.06" HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                <Ellipse Width="255" Height="255" Stroke="#FF2B3A45" StrokeThickness="1"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="TargetButton" Width="230" Height="230" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource CleanButtonStyle}" Click="Target_Click">
                    <Image Source="/Assets/mascot.png" Stretch="Uniform" IsHitTestVisible="False"/>
                </Button>
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding WelcomeMessage}" Style="{StaticResource BodyStyle}"
                       TextAlignment="Center" Margin="16,4,16,8" MaxHeight="46"/>

            <!-- Floating damage numbers and confetti are injected here at runtime. -->
            <Canvas x:Name="FxCanvas" Grid.RowSpan="3" IsHitTestVisible="False"/>
        </Grid>

        <Border Grid.Row="2" Background="#FF0D151C" Padding="12,6">
            <TextBlock Text="TIP: Buy upgrades from the Upgrades button. Defeat five targets to reboot the timeline."
                       FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="KillBanner" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="20,14" Background="#EE12222B" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="0,0,0,3" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="TARGET ELIMINATED" FontSize="20" Foreground="{StaticResource AccentBrush}"
                           TextAlignment="Center"/>
                <TextBlock x:Name="KillRewardText" Text="" FontSize="16" Foreground="{StaticResource WarmBrush}"
                           Margin="0,6,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <MediaElement x:Name="Sfx" Visibility="Collapsed"/>
    </Grid>
</UserControl>
