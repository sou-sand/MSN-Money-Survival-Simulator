<UserControl
    x:Class="MSN_Money_Survival_Simulator.AchievementsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#FF111B23" BorderBrush="#FF22303B" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TROPHY CASE" Style="{StaticResource TitleStyle}"/>
                    <TextBlock Text="Milestones unlock as you dismantle the money machine."
                               Style="{StaticResource BodyStyle}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="UNLOCKED" Style="{StaticResource LabelStyle}" TextAlignment="Right"/>
                    <TextBlock x:Name="UnlockCount" Text="0 / 0" FontSize="22"
                               Foreground="{StaticResource AccentBrush}" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox x:Name="AchievementList" Grid.Row="1" ItemsSource="{Binding Achievements}"
                 SelectionMode="Single" Background="Transparent" Padding="10,8,10,16">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding TileBrush}" BorderBrush="#FF31414C"
                            BorderThickness="1" Padding="12" Opacity="{Binding TileOpacity}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="34"
                                       Foreground="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Light"
                                           Foreground="{StaticResource BrightBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusText}"
                                       FontSize="11" Foreground="{Binding StatusBrush}" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
