<phone:PhoneApplicationPage
    x:Class="MSN_Money_Survival_Simulator.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="False">

    <Grid x:Name="LayoutRoot" Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Persistent HUD -->
        <Border Grid.Row="0" Background="#FF111B23" BorderBrush="#FF22303B" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="TOTAL CASH" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding CashText}" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="PER CLICK" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding ClickText}" Style="{StaticResource ValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="PER SECOND" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding DpsText}" Style="{StaticResource ValueStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                    <TextBlock Text="TARGETS DOWN" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding KillsText}" Style="{StaticResource ValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                    <TextBlock Text="ERA MULTIPLIER" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding MultiplierText}" FontSize="22" Foreground="{StaticResource WarmBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                    <TextBlock Text="COMBO" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding ComboText}" FontSize="16" Foreground="{StaticResource WarmBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic content: views are swapped into this host. -->
        <ContentControl x:Name="ContentHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>

        <!-- Transient notification -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,12,0,0" Padding="14,8" Background="#E613232C"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Text="" FontSize="13" Foreground="{StaticResource BrightBrush}"
                       TextWrapping="Wrap" MaxWidth="400"/>
        </Border>
    </Grid>

    <phone:PhoneApplicationPage.ApplicationBar>
        <shell:ApplicationBar IsVisible="True" IsMenuEnabled="True" Opacity="0.96"
                              BackgroundColor="#101820" ForegroundColor="#F2F7FA">
            <shell:ApplicationBar.Buttons>
                <shell:ApplicationBarIconButton x:Name="BarArena" IconUri="/Assets/icons/arena.png"
                                                Text="arena" Click="Nav_Click"/>
                <shell:ApplicationBarIconButton x:Name="BarShop" IconUri="/Assets/icons/shop.png"
                                                Text="upgrades" Click="Nav_Click"/>
                <shell:ApplicationBarIconButton x:Name="BarStats" IconUri="/Assets/icons/stats.png"
                                                Text="stats" Click="Nav_Click"/>
                <shell:ApplicationBarIconButton x:Name="BarSettings" IconUri="/Assets/icons/settings.png"
                                                Text="settings" Click="Nav_Click"/>
            </shell:ApplicationBar.Buttons>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem x:Name="MenuArena" Text="arena" Click="Nav_Click"/>
                <shell:ApplicationBarMenuItem x:Name="MenuShop" Text="upgrades" Click="Nav_Click"/>
                <shell:ApplicationBarMenuItem x:Name="MenuStats" Text="stats" Click="Nav_Click"/>
                <shell:ApplicationBarMenuItem x:Name="MenuAchievements" Text="trophies" Click="Nav_Click"/>
                <shell:ApplicationBarMenuItem x:Name="MenuSettings" Text="settings" Click="Nav_Click"/>
                <shell:ApplicationBarMenuItem x:Name="MenuSound" Text="sound: on" Click="Sound_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
    </phone:PhoneApplicationPage.ApplicationBar>
</phone:PhoneApplicationPage>
